# Public site URL (no trailing slash). Required for correct canonical URLs, sitemap, and Open Graph in production.
NEXT_PUBLIC_SITE_URL=https://smartbasa.com

# Local: same-origin proxy via Next rewrite (/api → Django). Or set absolute URL for direct CORS.
NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=http://127.0.0.1:8000
# Production (VPS): NEXT_PUBLIC_API_URL=https://api.smartbasa.com/api/v1
# SSR inside Docker uses API_INTERNAL_URL=http://api:8000/api/v1 (compose sets this).

# Legacy mock delay (off by default — API mode). Set true only for offline mock demos.
# NEXT_PUBLIC_USE_MOCK_DELAY=false
# NEXT_PUBLIC_MOCK_API_DELAY_MS=320

# Map search uses free Leaflet + OpenStreetMap (no key). See components/map/PropertyMap.GOOGLE.md for legacy Google notes.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SECURITY: Never prefix secrets with NEXT_PUBLIC_. API keys, JWT secrets, and DB URLs belong on the server only.
